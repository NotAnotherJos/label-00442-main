# ============================================================================
# .gitignore - Web Scraper 项目
# ============================================================================

# --------------------------------
# .NET / C# 相关
# --------------------------------
bin/
obj/
*.dll
*.exe
*.pdb
*.user
*.userosscache
*.sln.docstates
*.suo
*.cache
*.log

# NuGet
*.nupkg
**/packages/*
!**/packages/build/

# Visual Studio
.vs/
*.vspscc
*.vssscc
.builds

# JetBrains Rider
.idea/
*.sln.iml

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# --------------------------------
# 数据库文件
# --------------------------------
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# --------------------------------
# Docker 相关
# --------------------------------
.docker/

# --------------------------------
# IDE 和编辑器
# --------------------------------
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --------------------------------
# 日志文件
# --------------------------------
logs/
*.log
*.log.*
backend/logs/

# --------------------------------
# 测试覆盖率
# --------------------------------
coverage/
*.coverage
TestResults/
coverlet.runsettings

# --------------------------------
# 环境配置
# --------------------------------
.env
.env.local
.env.*.local
appsettings.local.json
appsettings.*.local.json

# --------------------------------
# 临时文件
# --------------------------------
tmp/
temp/
*.tmp
*.temp

# --------------------------------
# 构建输出
# --------------------------------
dist/
build/
publish/
out/

